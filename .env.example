# Copy this to .env and fill in real secrets before running anything beyond local dev

# Postgres
DATABASE_URL=postgresql://rfp_admin:change_me_locally@localhost:5432/rfp_automation

# Object storage (S3-compatible — MinIO locally now, Cloudflare R2 / AWS S3 on Render later.
# Only these 3 values change at migration time; the app code stays the same since it talks
# to a generic S3-compatible API.)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rfp_admin
S3_SECRET_KEY=change_me_locally
S3_BUCKET_KB_PERMANENT=kb-permanent
S3_BUCKET_STAGING=staging
S3_BUCKET_RFP_PERMANENT=rfp-permanent
S3_BUCKET_RFP_TMP=rfp-tmp

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRY_MINUTES=60
SESSION_SECRET=change_me_to_a_long_random_string

# Anthropic
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Embeddings — only used at Stage 3 of duplicate-check and for RAG indexing of ACCEPTED documents.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Near-duplicate detection thresholds
NEAR_DUPLICATE_SIMHASH_THRESHOLD=6
NEAR_DUPLICATE_COSINE_THRESHOLD=0.90
